# Huawei Cloud SMS Credentials
# Replace with your actual Huawei Cloud credentials
HUAWEI_SMS_AK="your-access-key-id"
HUAWEI_SMS_SK="your-secret-access-key"
HUAWEI_SMS_PROJECT_ID="your-project-id"
HUAWEI_SMS_REGION="la-south-2"  # Default region

# Optional: IAM endpoint (usually not needed)
# HUAWEI_SMS_IAM_ENDPOINT="https://iam.myhuaweicloud.com"

# Optional: SMS endpoint (usually not needed)
# HUAWEI_SMS_ENDPOINT="https://sms.{region}.myhuaweicloud.com"