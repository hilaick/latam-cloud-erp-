# Huawei Cloud Credentials
# Copy this file to ~/.huawei_credentials and fill in your credentials
# OR place it in config/.huawei_credentials in the project directory

# Required: Huawei Cloud API credentials
HUAWEI_ACCESS_KEY=your_access_key_here
HUAWEI_SECRET_KEY=your_secret_key_here
HUAWEI_PROJECT_ID=your_project_id_here
HUAWEI_REGION=la-north-2

# Optional: Dashboard password (for web interface)
DASHBOARD_PASSWORD=Cac-Prod!2024

# Optional: Huawei ModelArts API Keys (for load balancer)
# Get these from https://console.huaweicloud.com/modelarts/
API_KEY_1=your_api_key_1_here
API_KEY_2=your_api_key_2_here
API_KEY_3=your_api_key_3_here
API_KEY_4=your_api_key_4_here
API_KEY_5=your_api_key_5_here
API_KEY_6=your_api_key_6_here

# Optional: Load balancer authentication
# Used by huawei_load_balancer.py
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme123  # CHANGE THIS TO A STRONG PASSWORD!